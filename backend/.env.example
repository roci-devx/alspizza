# ─────────────────────────────────────────────────────────────────────────────
# Al's Pizza API configuration. Copy to `.env` and fill in what you have.
# Every integration is optional: anything left blank runs in demo/simulated mode
# so the whole ordering flow works locally with zero accounts.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"

# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Public URL of this API (used for PayPal return URLs and webhook signature checks)
API_PUBLIC_URL=http://localhost:4000
# Where the customer web app is served (Stripe Checkout / PayPal send shoppers back here)
WEB_APP_URL=http://localhost:5000
# Comma separated list of allowed browser origins. Leave blank to allow all (dev only).
CORS_ORIGINS=

# Block orders outside store hours (true in production)
ENFORCE_STORE_HOURS=false

# ── Demo helpers (ignored once real keys are present) ──────────────────────────
# Lets the app "pay" without a processor. Defaults to true only when Stripe isn't configured.
ALLOW_DEMO_PAYMENTS=
# Auto-advance new orders received → preparing → ready so you can watch the flow without the dashboard
DEMO_AUTO_KITCHEN=true
# Use a simulated courier when DoorDash/Uber keys are missing. 2 = twice as fast.
DELIVERY_SIMULATION=true
DELIVERY_SIM_SPEED=1

# ── Payments ──────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys  (Apple Pay + Google Pay ride on Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Apple Pay merchant id registered in your Apple developer account + Stripe dashboard
STRIPE_APPLE_MERCHANT_ID=merchant.com.alspizza.app

# https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# ── Delivery (white-label: customers only ever see Al's Pizza) ────────────────
# DoorDash Drive: https://developer.doordash.com/portal  → Credentials
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
# Value you set as the webhook "Authorization" header in the DoorDash portal
DOORDASH_WEBHOOK_AUTH=
# Poll DoorDash for courier GPS every N seconds while a delivery is active
DOORDASH_POLL_SECONDS=20

# Uber Direct (fallback courier network): https://direct.uber.com
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_CUSTOMER_ID=
UBER_WEBHOOK_SIGNING_KEY=

# Twilio relays in-app chat <-> courier SMS and forwards courier calls to the customer
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── POS (pick the one the restaurant uses in the owner dashboard → Settings) ──
SQUARE_ACCESS_TOKEN=
SQUARE_ENV=sandbox
SQUARE_VERSION=2025-01-23
SQUARE_WEBHOOK_SIGNATURE_KEY=

CLOVER_ACCESS_TOKEN=
CLOVER_MERCHANT_ID=
CLOVER_ENV=sandbox

# Toast requires approved partner credentials
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=
TOAST_HOST=https://ws-sandbox-api.eng.toasttab.com
TOAST_DINING_OPTION_TAKEOUT_GUID=
TOAST_DINING_OPTION_DELIVERY_GUID=

# ── Maps / geocoding ──────────────────────────────────────────────────────────
# Optional. Without it address search uses OpenStreetMap Nominatim (fine for dev, rate limited).
GOOGLE_MAPS_API_KEY=
NOMINATIM_CONTACT_EMAIL=

# ── End-of-day report email (optional) ────────────────────────────────────────
# e.g. smtps://user:pass@smtp.gmail.com:465
SMTP_URL=
REPORT_EMAIL_FROM="Al's Pizza Reports <reports@alspizza.com>"

# One-tap "Use demo account" buttons on the sign-in screens (defaults to on outside production)
# Password for owner@alspizza.com, used by `npm run setup` (blank = a random one is printed).
OWNER_PASSWORD=
DEMO_ACCOUNTS=
