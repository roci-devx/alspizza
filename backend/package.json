{
  "name": "als-pizza-api",
  "version": "1.0.0",
  "private": true,
  "description": "Al's Pizza ordering API: menu, cart pricing, orders, payments, delivery dispatch, POS sync, owner analytics and daily Excel reports.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:push": "prisma db push",
    "db:seed": "tsx src/seed/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx src/seed/seed.ts",
    "setup": "prisma db push && tsx src/seed/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^3.0.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "nodemailer": "^6.9.16",
    "stripe": "^18.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.5.13",
    "prisma": "^6.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
